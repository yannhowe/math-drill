{
  "name": "math-drill",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "concurrently -n server,web -c cyan,magenta \"pnpm --filter @math-drill/server dev\" \"pnpm --filter @math-drill/web dev\"",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
